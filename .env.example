# PostgreSQL Database URL (Docker Compose default)
DATABASE_URL="postgresql://lockit_user:lockit_password@localhost:5432/lockit_db?schema=public"

# JWT Secrets for Teacher Auth
JWT_ACCESS_SECRET="lockit_access_super_secret_key_change_in_production"
JWT_REFRESH_SECRET="lockit_refresh_super_secret_key_change_in_production"

# Secret for signing Student temporary session token
STUDENT_SESSION_SECRET="lockit_student_super_secret_key_change_in_production"

# Server configuration
PORT=3000
NODE_ENV=development
