# ─── DATABASE ──────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/db?connection_limit=N&pool_timeout=20
# connection_limit: jumlah max koneksi ke DB (default Prisma = num_cpus*2+1)
# Untuk ujian online 50-100 siswa simultan, set ke 10-15
DATABASE_URL="postgresql://lockit_user:GANTI_PASSWORD_AMAN@localhost:5432/lockit_db?schema=public&connection_limit=10&pool_timeout=20"

# ─── JWT SECRETS ───────────────────────────────────────────────────────────────
# WAJIB diisi — server akan CRASH saat startup jika tidak ada (CRIT-01)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="GANTI_DENGAN_STRING_ACAK_MIN_64_KARAKTER"
JWT_REFRESH_SECRET="GANTI_DENGAN_STRING_ACAK_MIN_64_KARAKTER_BERBEDA"
STUDENT_SESSION_SECRET="GANTI_DENGAN_STRING_ACAK_MIN_64_KARAKTER_KETIGA"

# ─── CORS SOCKET.IO ────────────────────────────────────────────────────────────
# WAJIB diisi untuk production — pisahkan multiple origin dengan koma (CRIT-02)
# Contoh: ALLOWED_ORIGINS="https://eduquas.sekolah.sch.id,https://www.eduquas.sekolah.sch.id"
ALLOWED_ORIGINS="http://localhost:3000"

# ─── SERVER ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

