generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── GURU/DOSEN ────────────────────────────────────

enum TeacherRole {
  TEACHER
  ADMIN
}

model Teacher {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name")
  // ─── RBAC ────────────────────────────────────────
  role         TeacherRole @default(TEACHER)
  isActive     Boolean     @default(true) @map("is_active")
  phone        String?
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz
  // ─────────────────────────────────────────────────
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  exams         Exam[]
  warnings      Warning[]
  refreshTokens RefreshToken[]

  @@index([role])
  @@index([isActive])
  @@map("teachers")
}

// ─── REFRESH TOKEN ─────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  teacherId String   @map("teacher_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  isRevoked Boolean  @default(false) @map("is_revoked")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("refresh_tokens")
}

// ─── UJIAN ─────────────────────────────────────────

enum ExamStatus {
  draft
  active
  ended
  archived
}

model Exam {
  id              String     @id @default(uuid())
  teacherId       String     @map("teacher_id")
  title           String
  description     String?
  accessCode      String     @unique @map("access_code")
  durationMinutes Int        @map("duration_minutes")
  status          ExamStatus @default(draft)
  violationPolicy Json       @default("{\"max_violations\": 3, \"action\": \"lock\", \"notify_student\": false}") @map("violation_policy")
  settings        Json       @default("{}")
  startTime       DateTime?  @map("start_time") @db.Timestamptz
  endTime         DateTime?  @map("end_time") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  teacher          Teacher           @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  questions        Question[]
  students         Student[]
  proctoringEvents ProctoringEvent[]
  warnings         Warning[]

  @@index([teacherId])
  @@index([status])
  @@map("exams")
}

// ─── SOAL ──────────────────────────────────────────

model Question {
  id           String   @id @default(uuid())
  examId       String   @map("exam_id")
  orderIndex   Int      @map("order_index")
  questionText String   @map("question_text")
  content      Json?
  imageUrl     String?  @map("image_url")
  imageAlt     String?  @map("image_alt")
  hint         String?
  hintContent  Json?    @map("hint_content")
  type         String   @default("single_choice")
  options      Json
  correctAnswer String  @map("correct_answer")
  points       Int      @default(10)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([examId])
  @@map("questions")
}

// Bank soal dapat digunakan bersama oleh guru dan admin. Soal ujian tetap snapshot.
model QuestionBank {
  id          String             @id @default(uuid())
  title       String
  subject     String
  description String?
  tags        Json               @default("[]")
  difficulty  String             @default("mixed")
  status      String             @default("draft")
  revision    Int                @default(1)
  createdBy   String             @map("created_by")
  updatedBy   String             @map("updated_by")
  importKey   String?            @unique @map("import_key")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  questions   BankQuestion[]
  drafts      QuestionBankDraft[]
  @@index([subject, status])
  @@map("question_banks")
}

model BankQuestion {
  id            String       @id @default(uuid())
  bankId        String       @map("bank_id")
  orderIndex    Int          @map("order_index")
  type          String
  questionText  String       @map("question_text")
  content       Json?
  imageUrl      String?      @map("image_url")
  imageAlt      String?      @map("image_alt")
  options       Json
  correctAnswer String?      @map("correct_answer")
  correctAnswers Json?       @map("correct_answers")
  points        Int          @default(10)
  hint          String?
  hintContent   Json?        @map("hint_content")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  bank          QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  @@index([bankId, orderIndex])
  @@map("bank_questions")
}

model QuestionBankDraft {
  id          String       @id @default(uuid())
  bankId      String       @map("bank_id")
  createdBy   String       @map("created_by")
  updatedBy   String       @map("updated_by")
  revision    Int          @default(1)
  content     Json
  committedAt DateTime?    @map("committed_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  bank        QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  @@index([bankId, updatedAt])
  @@map("question_bank_drafts")
}

model QuestionBankMedia {
  id         String   @id @default(uuid())
  filename   String   @unique
  mimeType   String   @map("mime_type")
  size       Int
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("question_bank_media")
}

// ─── PESERTA ───────────────────────────────────────

enum StudentStatus {
  waiting
  accepted
  active
  submitted
  disconnected
  kicked
}

model Student {
  id                String        @id @default(uuid())
  examId            String        @map("exam_id")
  name              String
  nisn              String
  // LOW-04: Simpan hash SHA-256 dari session token — konsisten dengan teacher refresh token.
  // JWT asli tidak pernah disimpan di DB; hanya hash-nya untuk verifikasi.
  sessionTokenHash  String        @map("session_token_hash")
  status            StudentStatus @default(waiting)
  isLocked          Boolean       @default(false) @map("is_locked")
  violationCount    Int           @default(0) @map("violation_count")
  ipAddress         String?       @map("ip_address")
  userAgent         String?       @map("user_agent")
  joinedAt          DateTime      @default(now()) @map("joined_at") @db.Timestamptz
  acceptedAt        DateTime?     @map("accepted_at") @db.Timestamptz
  kickedAt          DateTime?     @map("kicked_at") @db.Timestamptz
  kickReason        String?       @map("kick_reason")
  submittedAt       DateTime?     @map("submitted_at") @db.Timestamptz

  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Restrict)
  answers          Answer[]
  proctoringEvents ProctoringEvent[]
  warnings         Warning[]
  browserLinks     BrowserStudent[]

  @@unique([examId, nisn])
  @@index([sessionTokenHash])
  @@index([examId, status])
  @@map("students")
}

// ─── JAWABAN ───────────────────────────────────────

model Answer {
  id             String    @id @default(uuid())
  studentId      String    @map("student_id")
  questionId     String    @map("question_id")
  selectedOption String?   @map("selected_option")
  isCorrect      Boolean?  @map("is_correct")
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([studentId, questionId])
  @@map("answers")
}

// ─── IDENTITAS BROWSER SISWA ────────────────────────────────────────────────
model BrowserIdentity {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  students BrowserStudent[]

  @@map("browser_identities")
}

model BrowserStudent {
  browserId String   @map("browser_id")
  studentId String   @map("student_id")
  linkedAt  DateTime @default(now()) @map("linked_at") @db.Timestamptz

  browser BrowserIdentity @relation(fields: [browserId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([browserId, studentId])
  @@index([browserId, linkedAt])
  @@index([studentId])
  @@map("browser_students")
}

// ─── EVENT PROCTORING ──────────────────────────────
enum EventType {
  fullscreen_exit
  fullscreen_denied
  window_blur
  tab_switch
  copy_attempt
  paste_attempt
  right_click
  devtools
  reconnect
  heartbeat_lost
  ip_change
  screenshot
}

model ProctoringEvent {
  id         String    @id @default(uuid())
  studentId  String    @map("student_id")
  examId     String    @map("exam_id")
  eventType  EventType @map("event_type")
  timestamp  DateTime  @default(now()) @db.Timestamptz
  durationMs Int?      @map("duration_ms")
  metadata   Json?

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Restrict)

  @@index([examId, studentId])
  @@index([examId, timestamp])
  @@map("proctoring_events")
}

// ─── WARNING ───────────────────────────────────────

model Warning {
  id        String   @id @default(uuid())
  examId    String   @map("exam_id")
  studentId String   @map("student_id")
  teacherId String   @map("teacher_id")
  message   String
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz
  isRead    Boolean  @default(false) @map("is_read")

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@map("warnings")
}
